# These host values are for local tools / a locally run Backend.
# Docker Compose overrides POSTGRES_HOST/PORT and DATABASE_URL inside the Backend container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orgbrain_legal
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_TEST_DB=orgbrain_legal_test
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/orgbrain_legal
# Used by the Neo4j Docker Compose service (prepared infrastructure).
NEO4J_AUTH=neo4j/replace-with-a-strong-password
# Generate a new value for your local .env; do not reuse a key shared in chat.
SECRET_KEY=replace-with-a-new-random-secret-key-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================================== 
# AI & LLM Engine Configuration
# ============================================================================== 
# Provider selection: openai, deepseek, openrouter, kimi, ollama, fake, groq, huggingface, gemini
# Google is also accepted as an alias for Gemini (AI_PROVIDER=google).
AI_PROVIDER=openai
# This is the primary-provider model override; fallback providers use AI_MODEL_<PROVIDER>.
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
# Optional maximum output tokens. Leave blank to use the provider/model default.
# AI_MAX_TOKENS=4096
# Ordered provider failover list. The primary provider is automatically skipped if repeated.
# Local Ollama is opt-in: add it only when its API is reachable from the Backend container.
AI_FALLBACK_PROVIDERS=openai,deepseek,openrouter,groq,kimi,huggingface,gemini
# Optional model overrides for providers used as fallbacks (defaults are provider-specific).
AI_MODEL_OPENAI=gpt-4o
AI_MODEL_DEEPSEEK=deepseek-flash
AI_MODEL_OPENROUTER=deepseek/deepseek-v4.1-flash-1017
AI_MODEL_KIMI=moonshot-v1-8k
AI_MODEL_GROQ=openai/gpt-oss-120b
AI_MODEL_HUGGINGFACE=deepseek-ai/DeepSeek-V4.1-Flash-1017
AI_MODEL_OLLAMA=llama3
# Gemini model override (also used when Gemini is selected as a fallback).
AI_MODEL_GEMINI=gemini-3.8-flash

# OpenAI
# Replace every example API-key value in your local .env with a real key. Placeholder values are skipped by the AI provider layer.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Kimi / Moonshot AI
KIMI_API_KEY=your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Groq
# Put your newly rotated Groq key here; do not reuse the key previously shared in chat.
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini
# Use AI_PROVIDER=gemini or the supported alias AI_PROVIDER=google.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Hugging Face
# Set either HUGGINGFACE_API_KEY or HF_TOKEN; V6.1 accepts both.
HUGGINGFACE_API_KEY=PUT_YOUR_HUGGINGFACE_TOKEN_HERE
HF_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# ============================================================================== 
# Frontend Configuration
# ============================================================================== 
# Backend API URL for frontend integration
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000/api/v1
# Site URL for metadata and canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
