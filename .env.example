# ==============================================================================
# Database Configuration
# ==============================================================================
# These host values are for local tools / a locally run backend.
# Docker Compose overrides POSTGRES_HOST/PORT and DATABASE_URL inside the backend container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orgbrain_legal
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_TEST_DB=orgbrain_legal_test
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/orgbrain_legal

# JWT / Security Configuration
# Generate a new 32+ character random string for your local .env; never reuse shared keys.
SECRET_KEY=replace-with-a-new-random-secret-key-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# AI & LLM Engine Configuration
# ==============================================================================
# Provider selection: openai, deepseek, openrouter, kimi, ollama, fake, groq, huggingface, gemini
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_TEMPERATURE=0.7

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Kimi / Moonshot AI
KIMI_API_KEY=your-kimi-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Hugging Face
HUGGINGFACE_API_KEY=your-huggingface-api-key-here
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# ==============================================================================
# Frontend Configuration
# ==============================================================================
# Backend API URL for frontend integration (browser-facing)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000/api/v1
# Site URL for metadata and canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

ENVIRONMENT=production
ORGANIZATION_ID=org-brain-corp
ALLOW_TEST_OPERATOR=false
